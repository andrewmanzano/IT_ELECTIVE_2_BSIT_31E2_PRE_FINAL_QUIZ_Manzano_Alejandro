@model Manzano_Portfolio_Quiz.Models.Project

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Table of Contents</a></li>
            <li class="breadcrumb-item active">@Model.Title</li>
        </ol>
    </nav>

    <div class="row align-items-center mb-4">
        <div class="col-md-5 mb-3 mb-md-0">
            <img src="@Url.Content(Model.ThumbnailPath)" class="img-fluid rounded shadow border w-100" alt="@Model.Title detail preview" />
        </div>
        <div class="col-md-7 ps-md-4">
            <h1 class="fw-bold text-break mb-2">@Model.Title</h1>

            @if (Model.Technologies != null && Model.Technologies.Any())
            {
                <div class="mb-3">
                    @foreach (var tech in Model.Technologies)
                    {
                        <span class="badge bg-primary me-1 fs-6">@tech</span>
                    }
                </div>
            }

            <p class="lead mb-4">@Model.DetailedDescription</p>

            <a href="@Model.GitHubUrl" target="_blank" class="btn btn-dark btn-lg">
                <i class="bi bi-github"></i> View GitHub Repository
            </a>
        </div>
    </div>

    <hr class="my-5" />

    <div class="row">
        <div class="col-md-8">
            <h3 class="fw-bold mb-3">Project Comments (@Model.Comments.Count)</h3>

            <form asp-action="AddComment" method="post" class="card card-body shadow-sm mb-4">
                <input type="hidden" name="projectId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Your Name</label>
                    <input type="text" name="author" class="form-control" required placeholder="Enter your name..." />
                </div>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Comment</label>
                    <textarea name="text" class="form-control" rows="3" required placeholder="Write a comment..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary align-self-start">Post Comment</button>
            </form>

            <div class="list-group">
                @if (!Model.Comments.Any())
                {
                    <p class="text-muted">No comments yet. Be the first to leave one!</p>
                }
                else
                {
                    @foreach (var c in Model.Comments.OrderByDescending(x => x.CreatedAt))
                    {
                        <div class="list-group-item list-group-item-action flex-column align-items-start mb-2 rounded border">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1 fw-bold">@c.Author</h6>
                                <small class="text-muted">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                            <p class="mb-1">@c.Text</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>