@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: linear-gradient(135deg, #0f0c20 0%, #1f0e1a 50%, #0a0a0c 100%) !important;
        min-height: 100vh;
    }

    .login-wrapper-main {
        min-height: 75vh !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .login-card-custom {
        background: #ffffff !important;
        padding: 2.75rem 2.25rem !important;
        border-radius: 20px !important;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6) !important;
        width: 100% !important;
        max-width: 420px !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        position: relative;
    }

    .login-title {
        text-align: center !important;
        margin-bottom: 0.3rem !important;
        font-weight: 800 !important;
        font-size: 1.85rem !important;
        color: #0f172a !important;
    }

    .login-subtitle {
        text-align: center;
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 1.75rem;
        font-weight: 500;
    }

    .login-card-custom .form-label {
        font-weight: 600 !important;
        color: #334155 !important;
        margin-bottom: 0.4rem !important;
        font-size: 0.9rem;
    }

    .login-card-custom .form-control {
        border-radius: 10px !important;
        padding: 0.75rem 1rem !important;
        border: 2px solid #e2e8f0 !important;
        background-color: #f8fafc !important;
        font-size: 0.95rem;
        transition: all 0.2s ease-in-out;
    }

        .login-card-custom .form-control:focus {
            border-color: #dc2626 !important;
            background-color: #ffffff !important;
            box-shadow: 0 0 0 4px rgba(220, 38, 38, 0.15) !important;
        }

    .login-card-custom .btn-custom-login {
        width: 100% !important;
        padding: 0.85rem !important;
        border-radius: 10px !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
        letter-spacing: 0.5px;
        margin-top: 0.75rem !important;
        background: linear-gradient(135deg, #dc2626 0%, #000000 100%) !important;
        border: 1px solid #111827 !important;
        color: #ffffff !important;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.35);
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .login-card-custom .btn-custom-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.7);
            background: linear-gradient(135deg, #b91c1c 0%, #111827 100%) !important;
        }

        .login-card-custom .btn-custom-login:active {
            transform: translateY(0);
        }
</style>

<div class="login-wrapper-main">
    <div class="login-card-custom">
        <h2 class="login-title">Portfolio Login</h2>
        <p class="login-subtitle">Enter your credentials to access the portal</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center py-2 mb-3 rounded-3 fs-6">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" placeholder="Enter username..." required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Enter password..." required />
            </div>
            <button type="submit" class="btn-custom-login">Log In</button>
        </form>
    </div>
</div>