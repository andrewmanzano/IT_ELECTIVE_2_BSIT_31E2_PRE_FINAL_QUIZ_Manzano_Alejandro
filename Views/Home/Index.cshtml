@model IEnumerable<Manzano_Portfolio_Quiz.Models.Project>

@{
    ViewData["Title"] = "Portfolio Home";
}

<style>
    body {
        background: radial-gradient(circle at 10% 20%, rgba(168, 85, 247, 0.12) 0%, transparent 40%), radial-gradient(circle at 90% 15%, rgba(99, 102, 241, 0.12) 0%, transparent 45%), radial-gradient(circle at 50% 80%, rgba(236, 72, 153, 0.08) 0%, transparent 50%), linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e2e8f0 100%) !important;
        background-attachment: fixed !important;
        color: #0f172a !important;
        min-height: 100vh;
    }

    .hero-banner-custom {
        background: linear-gradient(135deg, #6d28d9 0%, #4c1d95 100%) !important;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(168, 85, 247, 0.3) !important;
        border-left: 6px solid #a855f7 !important;
        border-radius: 20px !important;
        padding: 2.5rem !important;
        box-shadow: 0 15px 35px rgba(109, 40, 217, 0.25) !important;
    }

        .hero-banner-custom h1 {
            color: #ffffff !important;
            font-weight: 800;
        }

        .hero-banner-custom p {
            color: #f3e8ff !important;
        }

    .section-title-custom {
        color: #0f172a !important;
        font-weight: 800 !important;
        border-bottom: 2px solid rgba(109, 40, 217, 0.3) !important;
    }

    .portfolio-card-custom {
        border-radius: 18px !important;
        overflow: hidden;
        backdrop-filter: blur(12px);
        border: 1px solid rgba(15, 23, 42, 0.12) !important;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease;
    }

        .portfolio-card-custom:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.15) !important;
        }

    .card-theme-0 {
        background: linear-gradient(145deg, #1e1b4b 0%, #0f172a 100%) !important;
    }

        .card-theme-0:hover {
            border-color: #ef4444 !important;
        }

    .card-theme-1 {
        background: linear-gradient(145deg, #311b92 0%, #0f172a 100%) !important;
    }

        .card-theme-1:hover {
            border-color: #6366f1 !important;
        }

    .card-theme-2 {
        background: linear-gradient(145deg, #4a148c 0%, #0f172a 100%) !important;
    }

        .card-theme-2:hover {
            border-color: #ec4899 !important;
        }

    .card-theme-3 {
        background: linear-gradient(145deg, #2e1065 0%, #0f172a 100%) !important;
    }

        .card-theme-3:hover {
            border-color: #a855f7 !important;
        }

    .portfolio-card-custom .card-title {
        color: #ffffff !important;
        font-weight: 700 !important;
        font-size: 1.15rem;
    }

    .portfolio-card-custom .card-text {
        color: #cbd5e1 !important;
    }

    .portfolio-card-custom .badge-custom {
        background: rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        backdrop-filter: blur(4px);
        font-weight: 600;
        padding: 0.35em 0.65em;
    }

    .btn-custom-red-black {
        width: 100% !important;
        padding: 0.7rem 1rem !important;
        border-radius: 10px !important;
        font-weight: 700 !important;
        font-size: 0.9rem !important;
        background: linear-gradient(135deg, #ef4444 0%, #991b1b 60%, #111827 100%) !important;
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
        transition: all 0.25s ease-in-out;
        text-align: center;
        text-decoration: none !important;
    }

        .btn-custom-red-black:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(220, 38, 38, 0.5);
            background: linear-gradient(135deg, #dc2626 0%, #b91c1c 60%, #1f2937 100%) !important;
            color: #ffffff !important;
        }
</style>

<div class="container mt-4 pb-5">
    <div class="hero-banner-custom mb-4">
        <h1 class="display-5">Manzano Alejandro's Portfolio</h1>
        <p class="col-md-8 fs-5 mb-0">Hello! Welcome to my Portfolio. You can view the complete source code on GitHub, or leave feedback in the comment section.</p>
    </div>

    <h2 class="mb-4 pb-2 section-title-custom">Table of Contents</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @{
            int index = 0;
        }
        @foreach (var project in Model)
        {
            var themeClass = "card-theme-" + (index % 4);
            index++;

            <div class="col">
                <div class="card h-100 portfolio-card-custom @themeClass">
                    <img src="@Url.Content(project.ThumbnailPath)" class="card-img-top" alt="@project.Title thumbnail" style="height: 180px; object-fit: cover; background-color: rgba(0, 0, 0, 0.3);">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">@project.Title</h5>
                        <p class="card-text flex-grow-1">@project.ShortDescription</p>

                        <div class="mb-3">
                            @foreach (var tech in project.Technologies)
                            {
                                <span class="badge badge-custom me-1 mb-1">@tech</span>
                            }
                        </div>

                        <a asp-controller="Projects" asp-action="Detail" asp-route-id="@project.Id" class="btn btn-custom-red-black mt-auto">View Details &amp; Comments</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>