@model IEnumerable<Manzano_Portfolio_Quiz.Models.Project>

<div class="container mt-4">
    <div class="p-4 mb-4 bg-dark text-white rounded-3 shadow-sm">
        <h1 class="display-5 fw-bold">Manzano Alejandro's Portfolio</h1>
        <p class="col-md-8 fs-5">Hello! Welcome to my Portfolio. You can view the complete source code on GitHub, or leave feedback in the comment section.</p>
    </div>

    <h2 class="mb-3 border-bottom pb-2">Table of Contents</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var project in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <img src="@Url.Content(project.ThumbnailPath)" class="card-img-top" alt="@project.Title thumbnail" style="height: 180px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">@project.Title</h5>
                        <p class="card-text text-muted flex-grow-1">@project.ShortDescription</p>
                        <div class="mb-3">
                            @foreach (var tech in project.Technologies)
                            {
                                <span class="badge bg-secondary me-1">@tech</span>
                            }
                        </div>
                        <a asp-controller="Projects" asp-action="Detail" asp-route-id="@project.Id" class="btn btn-outline-primary mt-auto">View Details &amp; Comments</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>